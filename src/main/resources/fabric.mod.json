{
	"schemaVersion": 1,
	"id": "betterpv",
	"version": "${version}",
	"name": "Better PV",
	"description": "A standalone Hypixel SkyBlock profile viewer, ported from the NotEnoughUpdates Profile Viewer (Forge 1.8.9) to Fabric 26.1.2. Use /pv, /neuprofile, /peek or /cata.",
	"authors": [
		"daweapon",
		"Moulberry and the NotEnoughUpdates contributors (original Profile Viewer)"
	],
	"contact": {
		"homepage": "https://github.com/daweapon/BetterPV",
		"sources": "https://github.com/daweapon/BetterPV",
		"issues": "https://github.com/daweapon/BetterPV/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/betterpv/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.moulberry.notenoughupdates.NotEnoughUpdates"
		],
		"client": [
			"io.github.moulberry.notenoughupdates.client.NotEnoughUpdatesClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
